index 1f84567..fddf966 100644
--- a/solution.py
+++ b/solution.py
@@ -30,4 +30,43 @@ def can_reach_end(n: int, m: int, a: int, b: int, bad_intervals: List[Tuple[int,
     >>> can_reach_end(100, 4, 10, 11, [(16, 18), (39, 42), (50, 55), (93, 99)])
     True
     """
-    pass
+    # Bit i records whether the square i positions behind the current one
+    # is reachable. Only the last b squares can affect the next jump.
+    mask = (1 << b) - 1
+    predecessors = mask ^ ((1 << (a - 1)) - 1)
+    state = 1
+    position = 1
+
+    def advance_good(state: int, count: int) -> int:
+        # The transition is deterministic, so repeated states let us skip
+        # arbitrarily long clear stretches (including fixed-length jumps).
+        seen = {}
+        step = 0
+        while step < count:
+            if state in seen:
+                period = step - seen[state]
+                remaining = (count - step) % period
+                for _ in range(remaining):
+                    state = ((state << 1) & mask) | bool(state & predecessors)
+                return state
+            seen[state] = step
+            state = ((state << 1) & mask) | bool(state & predecessors)
+            step += 1
+        return state
+
+    for left, right in bad_intervals:
+        if left > n:
+            break
+        # Square 1 is the starting position, not a landing square.
+        left = max(left, 2)
+        right = min(right, n)
+        if left > right:
+            continue
+        state = advance_good(state, left - position - 1)
+        state = (state << min(right - left + 1, b)) & mask
+        position = right
+        if not state:
+            return False
+
+    state = advance_good(state, n - position)
+    return bool(state & 1)
