diff --git a/solution.py b/solution.py
index b7192c8..45c49e4 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,44 @@ def count_polish_sequences(n: int, a: list[int]) -> int:
     >>> count_polish_sequences(4, [1, 1, 0, 0])
     0
     """
-    pass
+    mod = 998244353
+    factorial = [1] * (2 * n + 1)
+    for i in range(1, len(factorial)):
+        factorial[i] = factorial[i - 1] * i % mod
+    inverse = [1] * len(factorial)
+    inverse[-1] = pow(factorial[-1], mod - 2, mod)
+    for i in range(2 * n, 0, -1):
+        inverse[i - 1] = inverse[i] * i % mod
+
+    def choose(top, bottom):
+        if bottom < 0 or bottom > top:
+            return 0
+        return factorial[top] * inverse[bottom] % mod * inverse[top - bottom] % mod
+
+    answer = 0
+    slots = 1
+    for i, value in enumerate(a):
+        remaining = n - i - 1
+        # A prefix with `slots` open child positions becomes a forest with
+        # slots - 1 + k roots when the next node has k children.
+        low = slots - 1
+        high = min(slots + value - 2, remaining)
+        if low <= high:
+            if remaining == 0:
+                answer += 1  # Only the empty forest can complete the tree.
+            else:
+                # Forest counts are differences of adjacent binomial
+                # coefficients. Summing over k telescopes by hockey-stick.
+                left = 2 * remaining - low
+                right = 2 * remaining - high - 1
+                answer += (choose(left, remaining)
+                           - choose(right, remaining)
+                           - choose(left, remaining + 1)
+                           + choose(right, remaining + 1))
+            answer %= mod
+        slots += value - 1
+        if slots == 0:
+            return (answer + (remaining == 0)) % mod
+        if slots > remaining:
+            return answer
+    return answer
