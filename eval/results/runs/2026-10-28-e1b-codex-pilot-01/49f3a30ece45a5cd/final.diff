diff --git a/solution.py b/solution.py
index 2edca9e..357171b 100644
--- a/solution.py
+++ b/solution.py
@@ -29,4 +29,28 @@ def min_operations_to_rearrange(n: int, s: str, t: str) -> int:
     >>> min_operations_to_rearrange(3, 'BBW', 'BBW')
     0
     """
-    pass
+    from collections import deque
+
+    if s.count('B') != t.count('B'):
+        return -1
+    start, target = s + '..', t + '..'
+    queue = deque([(start, n, 0)])
+    seen = {start}
+
+    # Every move has the same cost, so BFS first reaches each state by a
+    # shortest path. The empty cells always form one adjacent pair.
+    while queue:
+        state, empty, distance = queue.popleft()
+        if state == target:
+            return distance
+        for source in range(n + 1):
+            if abs(source - empty) <= 1:
+                continue
+            cells = list(state)
+            cells[empty:empty + 2] = state[source:source + 2]
+            cells[source:source + 2] = '..'
+            next_state = ''.join(cells)
+            if next_state not in seen:
+                seen.add(next_state)
+                queue.append((next_state, source, distance + 1))
+    return -1
