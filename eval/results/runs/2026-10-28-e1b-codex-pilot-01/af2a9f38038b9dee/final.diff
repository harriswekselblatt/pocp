diff --git a/solution.py b/solution.py
index 083ef08..f80c44e 100644
--- a/solution.py
+++ b/solution.py
@@ -22,4 +22,23 @@ def count_in_degree_sequences(n: int, s: str) -> int:
     >>> count_in_degree_sequences(20, '00001100111010100101')
     261339902
     """
-    pass
+    # The number of distinct in-degree vectors equals the number of forests
+    # of the undirected graph (the lattice points of its graphical zonotope).
+    # For a proper subset of cycle edges, each path component can contain
+    # either no spoke or one of its available spokes: its weight is 1 + k.
+    # The circular transfer matrix [[2, 1], [2*k, 1+k]] sums these weights.
+    # Its trace also includes two invalid full-cycle configurations.
+    modulus = 998244353
+    a, b, c, d = 1, 0, 0, 1
+    for bit in s:
+        if bit == '0':
+            a, b, c, d = (
+                (2 * a) % modulus, (a + b) % modulus,
+                (2 * c) % modulus, (c + d) % modulus,
+            )
+        else:
+            a, b, c, d = (
+                (2 * (a + b)) % modulus, (a + 2 * b) % modulus,
+                (2 * (c + d)) % modulus, (c + 2 * d) % modulus,
+            )
+    return (a + d - 2) % modulus
