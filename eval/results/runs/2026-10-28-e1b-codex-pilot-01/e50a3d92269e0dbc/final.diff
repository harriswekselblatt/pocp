diff --git a/solution.py b/solution.py
index 2edca9e..2c32ee7 100644
--- a/solution.py
+++ b/solution.py
@@ -29,4 +29,42 @@ def min_operations_to_rearrange(n: int, s: str, t: str) -> int:
     >>> min_operations_to_rearrange(3, 'BBW', 'BBW')
     0
     """
-    pass
+    if s.count('B') != t.count('B'):
+        return -1
+    if s == t:
+        return 0
+
+    # A state records the black stones as bits and the start of the empty pair.
+    # White stones occupy every other cell, so no second stone mask is needed.
+    def encode(stones):
+        return sum(1 << i for i, stone in enumerate(stones) if stone == 'B')
+
+    start = (encode(s), n)
+    goal = (encode(t), n)
+    forward = {start: 0}
+    backward = {goal: 0}
+    frontier = {start}
+    opposite = {goal}
+
+    # Every move is reversible. Expand the smaller BFS layer from either end.
+    while frontier and opposite:
+        if len(frontier) > len(opposite):
+            frontier, opposite = opposite, frontier
+            forward, backward = backward, forward
+        next_frontier = set()
+        for mask, empty in frontier:
+            distance = forward[(mask, empty)] + 1
+            for source in range(n + 1):
+                if abs(source - empty) <= 1:
+                    continue
+                pair = (mask >> source) & 3
+                moved = (mask & ~(3 << source)) | (pair << empty)
+                state = (moved, source)
+                if state in forward:
+                    continue
+                if state in backward:
+                    return distance + backward[state]
+                forward[state] = distance
+                next_frontier.add(state)
+        frontier = next_frontier
+    return -1
