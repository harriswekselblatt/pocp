diff --git a/solution.py b/solution.py
index b7192c8..5585605 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,43 @@ def count_polish_sequences(n: int, a: list[int]) -> int:
     >>> count_polish_sequences(4, [1, 1, 0, 0])
     0
     """
-    pass
+    modulus = 998244353
+    factorial = [1] * (2 * n + 1)
+    for i in range(1, len(factorial)):
+        factorial[i] = factorial[i - 1] * i % modulus
+    inverse_factorial = [1] * len(factorial)
+    inverse_factorial[-1] = pow(factorial[-1], modulus - 2, modulus)
+    for i in range(2 * n, 0, -1):
+        inverse_factorial[i - 1] = inverse_factorial[i] * i % modulus
+
+    def choose(total: int, selected: int) -> int:
+        if selected < 0 or selected > total:
+            return 0
+        return (factorial[total] * inverse_factorial[selected]
+                * inverse_factorial[total - selected]) % modulus
+
+    answer = 0
+    slots = 1
+    for i, degree in enumerate(a):
+        remaining = n - i - 1
+        # A smaller degree leaves between low and high pending subtrees.
+        low = slots - 1
+        high = slots + degree - 2
+        if remaining == 0:
+            answer += int(low <= 0 <= high)
+        else:
+            low = max(low, 1)
+            high = min(high, remaining)
+            if low <= high:
+                # Forests on r nodes with s roots number
+                # C(2r-s-1, r-1) - C(2r-s-1, r).
+                # Summing over s telescopes by the hockey-stick identity.
+                answer += (choose(2 * remaining - low, remaining)
+                           - choose(2 * remaining - high - 1, remaining)
+                           - choose(2 * remaining - low, remaining + 1)
+                           + choose(2 * remaining - high - 1, remaining + 1))
+        answer %= modulus
+        slots += degree - 1
+        if slots <= 0 or slots > remaining:
+            return (answer + int(slots == 0 and remaining == 0)) % modulus
+    return answer
