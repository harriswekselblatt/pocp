diff --git a/solution.py b/solution.py
index b957b01..5facaa2 100644
--- a/solution.py
+++ b/solution.py
@@ -27,4 +27,20 @@ def calculate_black_area_doubled(A: int, B: int, C: int, D: int) -> int:
     >>> calculate_black_area_doubled(-1000000000, -1000000000, 1000000000, 1000000000)
     4000000000000000000
     """
-    pass
+    # Doubled black areas of unit cells in the repeating 4-by-2 tile.
+    rows = ((2, 1, 0, 1), (1, 2, 1, 0))
+
+    def prefix(x: int, y: int) -> int:
+        # Floor division keeps the same periodic extension at negative coordinates.
+        horizontal_tiles, remaining_columns = divmod(x, 4)
+        vertical_tiles, remaining_rows = divmod(y, 2)
+        area = horizontal_tiles * vertical_tiles * 8
+        area += vertical_tiles * sum(
+            rows[0][column] + rows[1][column]
+            for column in range(remaining_columns)
+        )
+        if remaining_rows:
+            area += horizontal_tiles * 4 + sum(rows[0][:remaining_columns])
+        return area
+
+    return prefix(C, D) - prefix(A, D) - prefix(C, B) + prefix(A, B)
