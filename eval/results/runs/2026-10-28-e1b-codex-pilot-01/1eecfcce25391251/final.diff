+    assert candidate(5, 1, 4, '00000', '11111') == False
+    assert candidate(5, 4, 3, '00011', '10110') == False
+    assert candidate(6, 4, 1, '111000', '111111') == False
+    assert candidate(3, 3, 3, '101', '000') == False
