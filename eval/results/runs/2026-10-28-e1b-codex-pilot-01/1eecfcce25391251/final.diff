index 00f8fc6..d20140f 100644
--- a/solution.py
+++ b/solution.py
@@ -26,4 +26,45 @@ def can_transform_string(n: int, x: int, y: int, s: str, t: str) -> bool:
     >>> can_transform_string(3, 1, 2, '001', '001')
     True
     """
-    pass
+    def normal_form(word):
+        # Orient every swap as 1**y 0**x -> 0**x 1**y. These
+        # reductions terminate (inversions decrease) and cannot overlap,
+        # so every connected component has a unique normal form.
+        runs = []
+
+        def append(bit, count):
+            if count:
+                if runs and runs[-1][0] == bit:
+                    runs[-1] = (bit, runs[-1][1] + count)
+                else:
+                    runs.append((bit, count))
+
+        from itertools import groupby
+        for bit, group in groupby(word):
+            count = sum(1 for _ in group)
+            if bit == '1':
+                append(bit, count)
+                continue
+            suffix = []
+            while runs and count >= x:
+                if runs[-1][0] == '0':
+                    count += runs.pop()[1]
+                    continue
+                ones = runs[-1][1]
+                if ones < y:
+                    break
+                runs.pop()
+                moving_ones = ones - ones % y
+                moving_zeros = count - count % x
+                suffix.append((moving_ones, count % x))
+                count = moving_zeros
+                if ones % y:
+                    append('1', ones % y)
+                    break
+            append('0', count)
+            for ones, zeros in reversed(suffix):
+                append('1', ones)
+                append('0', zeros)
+        return runs
+
+    return s.count('1') == t.count('1') and normal_form(s) == normal_form(t)
