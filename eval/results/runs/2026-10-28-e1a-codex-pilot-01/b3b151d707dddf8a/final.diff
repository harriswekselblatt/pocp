@@ -27,4 +27,18 @@ def calculate_black_area_doubled(A: int, B: int, C: int, D: int) -> int:
     >>> calculate_black_area_doubled(-1000000000, -1000000000, 1000000000, 1000000000)
     4000000000000000000
     """
-    pass
+    # Each entry is twice the black area in a unit square. The pattern
+    # repeats every four columns and every two rows.
+    rows = ((2, 1, 0, 1), (1, 2, 1, 0))
+
+    def prefix(x: int, y: int) -> int:
+        # Floor division also extends this signed prefix to negative bounds.
+        blocks_x, remainder_x = divmod(x, 4)
+        blocks_y, remainder_y = divmod(y, 2)
+        area = blocks_x * blocks_y * 8
+        area += blocks_y * sum(rows[0][:remainder_x] + rows[1][:remainder_x])
+        if remainder_y:
+            area += blocks_x * 4 + sum(rows[0][:remainder_x])
+        return area
+
+    return prefix(C, D) - prefix(A, D) - prefix(C, B) + prefix(A, B)
