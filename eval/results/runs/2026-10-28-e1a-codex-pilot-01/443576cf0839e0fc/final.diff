diff --git a/solution.py b/solution.py
index 067e101..ff9dc8b 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,21 @@ def max_1122_subarray_length(n: int, a: List[int]) -> int:
     >>> max_1122_subarray_length(1, [1])
     0
     """
-    pass
+    best = 0
+    # Pair boundaries can start at either an even or an odd index.
+    for parity in (0, 1):
+        left = parity
+        last_seen = {}
+        for right in range(parity, n - 1, 2):
+            value = a[right]
+            if value != a[right + 1]:
+                left = right + 2
+                continue
+
+            # Keep only distinct equal pairs in the current window.
+            previous = last_seen.get(value, -2)
+            left = max(left, previous + 2)
+            last_seen[value] = right
+            best = max(best, right + 2 - left)
+
+    return best
