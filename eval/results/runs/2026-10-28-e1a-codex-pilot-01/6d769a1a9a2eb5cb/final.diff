diff --git a/solution.py b/solution.py
index 2edca9e..305ff54 100644
--- a/solution.py
+++ b/solution.py
@@ -29,4 +29,42 @@ def min_operations_to_rearrange(n: int, s: str, t: str) -> int:
     >>> min_operations_to_rearrange(3, 'BBW', 'BBW')
     0
     """
-    pass
+    if s.count('B') != t.count('B'):
+        return -1
+    if s == t:
+        return 0
+
+    # A state stores the black-stone bitmask and the first empty cell.
+    # White stones occupy all remaining nonempty cells.
+    start = (sum((c == 'B') << i for i, c in enumerate(s)), n)
+    goal = (sum((c == 'B') << i for i, c in enumerate(t)), n)
+    frontier, other_frontier = {start}, {goal}
+    distances, other_distances = {start: 0}, {goal: 0}
+
+    # Moves are reversible, so search from both ends, expanding a full
+    # layer of the smaller frontier each time.
+    while frontier and other_frontier:
+        if len(frontier) > len(other_frontier):
+            frontier, other_frontier = other_frontier, frontier
+            distances, other_distances = other_distances, distances
+        next_frontier = set()
+        best = None
+        for mask, empty in frontier:
+            distance = distances[(mask, empty)] + 1
+            for source in range(n + 1):
+                if empty - 1 <= source <= empty + 1:
+                    continue
+                pair = (mask >> source) & 3
+                moved_mask = (mask & ~(3 << source)) | (pair << empty)
+                state = (moved_mask, source)
+                if state in distances:
+                    continue
+                if state in other_distances:
+                    total = distance + other_distances[state]
+                    best = total if best is None else min(best, total)
+                distances[state] = distance
+                next_frontier.add(state)
+        if best is not None:
+            return best
+        frontier = next_frontier
+    return -1
