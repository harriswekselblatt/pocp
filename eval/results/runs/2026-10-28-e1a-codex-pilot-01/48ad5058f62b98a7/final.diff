--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,25 @@ def min_cost_to_sort(n: int, permutation: List[int]) -> int:
     >>> min_cost_to_sort(2, [1, 2])
     0
     """
-    pass
+    # Insertion sort resolves each inversion as far left (and therefore as
+    # cheaply) as possible. Count the larger preceding values with a Fenwick
+    # tree so that we can sum its swap costs without performing the swaps.
+    tree = [0] * (n + 1)
+    cost = 0
+    for index, value in enumerate(permutation):
+        prefix_count = 0
+        cursor = value
+        while cursor:
+            prefix_count += tree[cursor]
+            cursor -= cursor & -cursor
+
+        larger_count = index - prefix_count
+        # The element crosses edges index, index - 1, ..., index - k + 1.
+        cost += larger_count * (2 * index - larger_count + 1) // 2
+
+        cursor = value
+        while cursor <= n:
+            tree[cursor] += 1
+            cursor += cursor & -cursor
+
+    return cost
