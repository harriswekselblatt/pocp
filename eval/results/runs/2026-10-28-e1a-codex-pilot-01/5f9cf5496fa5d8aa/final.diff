diff --git a/solution.py b/solution.py
index 1f84567..13097f8 100644
--- a/solution.py
+++ b/solution.py
@@ -30,4 +30,50 @@ def can_reach_end(n: int, m: int, a: int, b: int, bad_intervals: List[Tuple[int,
     >>> can_reach_end(100, 4, 10, 11, [(16, 18), (39, 42), (50, 55), (93, 99)])
     True
     """
-    pass
+    # A fixed jump size only visits one arithmetic progression.
+    if a == b:
+        if (n - 1) % a:
+            return False
+        for left, right in bad_intervals:
+            left = max(2, left)
+            right = min(n, right)
+            first_landing = left + (1 - left) % a
+            if first_landing <= right:
+                return False
+        return True
+
+    # Bit i records whether the square i positions behind the current one
+    # is reachable. Only the last b squares can affect the next landing.
+    mask = (1 << b) - 1
+    predecessors = ((1 << (b - a + 1)) - 1) << (a - 1)
+    state = 1
+
+    def advance_good(length: int) -> None:
+        nonlocal state
+        seen = {}
+        step = 0
+        while step < length:
+            if state in seen:
+                period = step - seen[state]
+                remaining = (length - step) % period
+                for _ in range(remaining):
+                    state = ((state << 1) & mask) | bool(state & predecessors)
+                return
+            seen[state] = step
+            state = ((state << 1) & mask) | bool(state & predecessors)
+            step += 1
+
+    current = 1
+    for left, right in bad_intervals:
+        left, right = max(2, left), min(n, right)
+        if left > right:
+            continue
+        advance_good(left - current - 1)
+        # Bad squares cannot be reached, but earlier reachable squares can
+        # still supply jumps across a short bad interval.
+        state = (state << min(b, right - left + 1)) & mask
+        current = right
+        if not state:
+            return False
+    advance_good(n - current)
+    return bool(state & 1)
