--- a/solution.py
+++ b/solution.py
@@ -30,4 +30,45 @@ def can_reach_end(n: int, m: int, a: int, b: int, bad_intervals: List[Tuple[int,
     >>> can_reach_end(100, 4, 10, 11, [(16, 18), (39, 42), (50, 55), (93, 99)])
     True
     """
-    pass
+    # Bit i records whether the square i places behind the current one is
+    # reachable. Only the last b squares can affect a future landing.
+    state = 1
+    window_mask = (1 << b) - 1
+    jump_mask = ((1 << (b - a + 1)) - 1) << (a - 1)
+
+    def advance_good(length: int) -> None:
+        nonlocal state
+        # An unobstructed stretch applies the same transition repeatedly.
+        # Skip cycles so even stretches of length 10**12 are inexpensive.
+        seen = {}
+        step = 0
+        while step < length:
+            if state in seen:
+                period = step - seen[state]
+                remaining = (length - step) % period
+                for _ in range(remaining):
+                    state = ((state << 1) & window_mask) | bool(state & jump_mask)
+                return
+            seen[state] = step
+            state = ((state << 1) & window_mask) | bool(state & jump_mask)
+            step += 1
+
+    position = 1
+    for left, right in bad_intervals:
+        if left > n:
+            break
+        if right < 1:
+            continue
+        if left <= 1 <= right:
+            return False
+        advance_good(left - position - 1)
+        # Bad squares cannot be landed on; they only age the reachability
+        # window. A full window of bad squares makes further progress impossible.
+        length = min(right, n) - left + 1
+        state = (state << length) & window_mask if length < b else 0
+        position = min(right, n)
+        if not state:
+            return False
+
+    advance_good(n - position)
+    return bool(state & 1)
