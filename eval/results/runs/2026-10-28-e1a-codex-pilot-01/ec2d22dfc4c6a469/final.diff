--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,44 @@ def count_polish_sequences(n: int, a: list[int]) -> int:
     >>> count_polish_sequences(4, [1, 1, 0, 0])
     0
     """
-    pass
+    mod = 998244353
+    factorial = [1] * (2 * n + 1)
+    for i in range(1, len(factorial)):
+        factorial[i] = factorial[i - 1] * i % mod
+    inverse = [1] * len(factorial)
+    inverse[-1] = pow(factorial[-1], mod - 2, mod)
+    for i in range(2 * n, 0, -1):
+        inverse[i - 1] = inverse[i] * i % mod
+
+    def choose(top, bottom):
+        if bottom < 0 or top < bottom:
+            return 0
+        return factorial[top] * inverse[bottom] % mod * inverse[top - bottom] % mod
+
+    answer = 0
+    slots = 1
+    for i, value in enumerate(a):
+        remaining = n - i - 1
+        # A smaller value leaves between low and high open tree roots.
+        low = max(1, slots - 1)
+        high = min(remaining, slots + value - 2)
+        if remaining == 0:
+            if slots == 1 and value > 0:
+                answer += 1
+        elif low <= high:
+            # A forest with m nodes and t roots has
+            # C(2m-t-1, m-1) - C(2m-t-1, m) realizations.
+            # Sum over t using the hockey-stick binomial identity.
+            answer += (
+                choose(2 * remaining - low, remaining)
+                - choose(2 * remaining - high - 1, remaining)
+                - choose(2 * remaining - low, remaining + 1)
+                + choose(2 * remaining - high - 1, remaining + 1)
+            )
+        answer %= mod
+        slots += value - 1
+        if slots == 0:
+            return (answer + (remaining == 0)) % mod
+        if slots > remaining:
+            return answer
+    return answer
