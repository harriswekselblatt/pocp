diff --git a/solution.py b/solution.py
index 9a7d7ae..35ee00a 100644
--- a/solution.py
+++ b/solution.py
@@ -21,4 +21,23 @@ def count_k_reducible(s: str, k: int) -> int:
     >>> count_k_reducible("1", 3)
     0
     """
-    pass
+    modulus = 10**9 + 7
+    length = len(s)
+
+    # Once the first operation is applied, only the set-bit count matters.
+    steps = [0] * (length + 1)
+    for ones in range(2, length + 1):
+        steps[ones] = 1 + steps[ones.bit_count()]
+
+    # Count prefixes already smaller than s, grouped by their set-bit count.
+    smaller = [0] * (length + 1)
+    equal_ones = 0
+    for position, bit in enumerate(s):
+        for ones in range(position + 1, 0, -1):
+            smaller[ones] = (smaller[ones] + smaller[ones - 1]) % modulus
+        if bit == "1":
+            smaller[equal_ones] = (smaller[equal_ones] + 1) % modulus
+            equal_ones += 1
+
+    return sum(smaller[ones] for ones in range(1, length + 1)
+               if steps[ones] < k) % modulus
