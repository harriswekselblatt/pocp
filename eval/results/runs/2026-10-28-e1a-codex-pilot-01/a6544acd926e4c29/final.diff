diff --git a/solution.py b/solution.py
index b7192c8..faad9e8 100644
--- a/solution.py
+++ b/solution.py
@@ -20,4 +20,36 @@ def count_polish_sequences(n: int, a: list[int]) -> int:
     >>> count_polish_sequences(4, [1, 1, 0, 0])
     0
     """
-    pass
+    mod = 998244353
+    limit = 2 * n + 2
+    factorial = [1] * (limit + 1)
+    for i in range(1, limit + 1):
+        factorial[i] = factorial[i - 1] * i % mod
+    inverse_factorial = [1] * (limit + 1)
+    inverse_factorial[limit] = pow(factorial[limit], mod - 2, mod)
+    for i in range(limit, 0, -1):
+        inverse_factorial[i - 1] = inverse_factorial[i] * i % mod
+
+    def forests(nodes: int, roots: int) -> int:
+        # [z^nodes] T(z)^roots, where T = z / (1 - T).
+        if roots < 1 or roots > nodes:
+            return 0
+        return (roots * factorial[2 * nodes - roots - 1]
+                * inverse_factorial[nodes]
+                * inverse_factorial[nodes - roots]) % mod
+
+    answer = 0
+    slots = 1
+    for i, value in enumerate(a):
+        remaining = n - i - 1
+        # Sum completions for every smaller value at this position.
+        # Sum_{k >= l} T^k = T^(l+1) / z gives a telescoping sum.
+        answer += (forests(remaining + 1, slots)
+                   - forests(remaining + 1, slots + value))
+        answer %= mod
+        slots += value - 1
+        if slots == 0:
+            return (answer + (remaining == 0)) % mod
+        if slots > remaining:
+            return answer
+    return answer
