--- a/solution.py
+++ b/solution.py
@@ -21,4 +21,24 @@ def count_k_reducible(s: str, k: int) -> int:
     >>> count_k_reducible("1", 3)
     0
     """
-    pass
+    modulus = 10**9 + 7
+    length = len(s)
+
+    # After the first operation, only the number of set bits matters.
+    steps = [0] * (length + 1)
+    for ones in range(2, length + 1):
+        steps[ones] = 1 + steps[ones.bit_count()]
+
+    # Count strictly smaller binary strings by their number of set bits.
+    # The single prefix equal to s is tracked separately from smaller prefixes.
+    counts = [0] * (length + 1)
+    prefix_ones = 0
+    for position, bit in enumerate(s):
+        for ones in range(position + 1, 0, -1):
+            counts[ones] = (counts[ones] + counts[ones - 1]) % modulus
+        if bit == "1":
+            counts[prefix_ones] = (counts[prefix_ones] + 1) % modulus
+            prefix_ones += 1
+
+    return sum(counts[ones] for ones in range(1, length + 1)
+               if steps[ones] < k) % modulus
