@@ -20,4 +20,22 @@ def min_cost_to_sort(n: int, permutation: List[int]) -> int:
     >>> min_cost_to_sort(2, [1, 2])
     0
     """
-    pass
+    # Insert each value into the sorted prefix. If k preceding values are
+    # larger, it crosses the boundaries i, i-1, ..., i-k+1 (1-indexed).
+    # Sorting the prefix first lets these crossings use the cheapest positions.
+    tree = [0] * (n + 1)
+    total = 0
+    for i, value in enumerate(permutation):
+        count = 0
+        index = value
+        while index > 0:
+            count += tree[index]
+            index -= index & -index
+        larger = i - count
+        total += larger * (2 * i - larger + 1) // 2
+
+        index = value
+        while index <= n:
+            tree[index] += 1
+            index += index & -index
+    return total
