diff --git a/solution.py b/solution.py
index b957b01..251ddcc 100644
--- a/solution.py
+++ b/solution.py
@@ -27,4 +27,18 @@ def calculate_black_area_doubled(A: int, B: int, C: int, D: int) -> int:
     >>> calculate_black_area_doubled(-1000000000, -1000000000, 1000000000, 1000000000)
     4000000000000000000
     """
-    pass
+    # Doubled black areas in the unit cells of the repeating 4-by-2 tile.
+    rows = ((2, 1, 0, 1), (1, 2, 1, 0))
+
+    def prefix(x: int, y: int) -> int:
+        """Signed area from the origin; floor division also handles negatives."""
+        x_tiles, x_rest = divmod(x, 4)
+        y_tiles, y_rest = divmod(y, 2)
+        return (
+            8 * x_tiles * y_tiles
+            + y_tiles * sum(rows[0][:x_rest] + rows[1][:x_rest])
+            + x_tiles * sum(sum(row) for row in rows[:y_rest])
+            + sum(sum(row[:x_rest]) for row in rows[:y_rest])
+        )
+
+    return prefix(C, D) - prefix(A, D) - prefix(C, B) + prefix(A, B)
