diff --git a/solution.py b/solution.py
index 559d9a5..8771571 100644
--- a/solution.py
+++ b/solution.py
@@ -24,4 +24,32 @@ def find_cube_placement(V1: int, V2: int, V3: int) -> Optional[Tuple[int, int, i
     >>> find_cube_placement(343, 34, 3)
     None
     """
-    pass
+    if min(V1, V2, V3) < 0 or V1 + 2 * V2 + 3 * V3 != 3 * 7**3:
+        return None
+
+    # Fix the first cube at the origin. On each axis, consecutive gaps
+    # between cube starts can be capped at 7 without changing any overlap.
+    # Thus offsets in [-14, 14] cover every possible overlap pattern.
+    patterns = {}
+    for b in range(-14, 15):
+        for c in range(-14, 15):
+            overlaps = (
+                max(0, 7 - abs(b)),
+                max(0, 7 - abs(c)),
+                max(0, 7 - abs(b - c)),
+                max(0, 7 - (max(0, b, c) - min(0, b, c))),
+            )
+            patterns.setdefault(overlaps, (b, c))
+
+    axes = list(patterns.items())
+    pair_volume = V2 + 3 * V3
+    for x, (bx, cx) in axes:
+        for y, (by, cy) in axes:
+            xy12, xy13, xy23 = (x[i] * y[i] for i in range(3))
+            xy123 = x[3] * y[3]
+            for z, (bz, cz) in axes:
+                if xy123 * z[3] != V3:
+                    continue
+                if xy12 * z[0] + xy13 * z[1] + xy23 * z[2] == pair_volume:
+                    return (0, 0, 0, bx, by, bz, cx, cy, cz)
+    return None
