-    pass
+    modulus = 998244353
+    inverses = [0] * (N + 1)
+    inverses[1] = 1
+    harmonic = 1
+    for i in range(2, N + 1):
+        inverses[i] = -(modulus // i) * inverses[modulus % i] % modulus
