diff --git a/solution.py b/solution.py
index 571a8c1..6fbe0da 100644
--- a/solution.py
+++ b/solution.py
@@ -21,4 +21,42 @@ def can_transform(k: int, s: str, t: str) -> bool:
     >>> can_transform(17, 'twothousandtwentyfour', 'happynewyear')
     True
     """
-    pass
+    if abs(len(s) - len(t)) > k:
+        return False
+
+    # Common ends can be matched without using any edits.
+    start = 0
+    end_s, end_t = len(s), len(t)
+    while start < min(end_s, end_t) and s[start] == t[start]:
+        start += 1
+    while end_s > start and end_t > start and s[end_s - 1] == t[end_t - 1]:
+        end_s -= 1
+        end_t -= 1
+    s, t = s[start:end_s], t[start:end_t]
+    if max(len(s), len(t)) <= k:
+        return True
+
+    # A path costing at most k never leaves the width-k diagonal band.
+    # Store only that band, keeping memory proportional to k.
+    n, m = len(s), len(t)
+    unreachable = k + 1
+    previous_start = 0
+    previous = list(range(min(m, k) + 1))
+    for i in range(1, n + 1):
+        row_start, row_end = max(0, i - k), min(m, i + k)
+        current = []
+        for j in range(row_start, row_end + 1):
+            above = j - previous_start
+            deletion = previous[above] + 1 if 0 <= above < len(previous) else unreachable
+            insertion = current[-1] + 1 if current else unreachable
+            diagonal = above - 1
+            replacement = (
+                previous[diagonal] + (s[i - 1] != t[j - 1])
+                if j > 0 and 0 <= diagonal < len(previous)
+                else unreachable
+            )
+            current.append(min(deletion, insertion, replacement))
+        if min(current) > k:
+            return False
+        previous, previous_start = current, row_start
+    return previous[m - previous_start] <= k
