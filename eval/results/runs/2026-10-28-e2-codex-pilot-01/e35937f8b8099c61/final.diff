@@ -24,4 +24,13 @@ def expected_black_ball_position(N: int, K: int) -> int:
     >>> expected_black_ball_position(4, 4)
     592707587
     """
-    pass
+    modulus = 998244353
+    inverse_n = pow(N, modulus - 2, modulus)
+    inverse_two = (modulus + 1) // 2
+
+    # From position x, moving to each other position has probability 2/N^2.
+    # Thus E[next] = (1 - 2/N) * E[current] + (N + 1)/N.
+    # Its fixed point is the uniform mean (N + 1)/2; the initial mean is 1.
+    uniform_mean = (N + 1) * inverse_two % modulus
+    decay = pow((1 - 2 * inverse_n) % modulus, K, modulus)
+    return (uniform_mean + (1 - uniform_mean) * decay) % modulus
