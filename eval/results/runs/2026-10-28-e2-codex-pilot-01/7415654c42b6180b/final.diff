@@ -16,4 +16,24 @@ def max_score(grid: List[List[int]]) -> int:
     >>> max_score([[8,7,6],[8,3,2]])
     15
     """
-    pass
+    rows_by_value = {}
+    for row_index, row in enumerate(grid):
+        for value in set(row):
+            rows_by_value.setdefault(value, []).append(row_index)
+
+    # Each mask records occupied rows. Process each value once so that it
+    # can be assigned to at most one row.
+    scores = {0: 0}
+    for value, rows in rows_by_value.items():
+        next_scores = scores.copy()
+        for mask, score in scores.items():
+            for row_index in rows:
+                bit = 1 << row_index
+                if not mask & bit:
+                    next_mask = mask | bit
+                    next_scores[next_mask] = max(
+                        next_scores.get(next_mask, 0), score + value
+                    )
+        scores = next_scores
+
+    return max(scores.values())
