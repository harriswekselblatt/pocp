--- a/solution.py
+++ b/solution.py
@@ -28,4 +28,37 @@ def max_production_capacity(n: int, x: int, machines: List[Tuple[int, int, int,
     >>> max_production_capacity(1, 1, [(1, 10000000, 1, 10000000)])
     0
     """
-    pass
+    from math import gcd
+
+    processes = []
+    for a, p, b, q in machines:
+        # Make S the cheaper type per unit of capacity.
+        if p * b > q * a:
+            a, p, b, q = b, q, a, p
+        # a/gcd(a,b) T machines can be replaced by b/gcd(a,b)
+        # S machines with equal capacity and no greater cost.
+        processes.append((a, p, b, q, a // gcd(a, b)))
+
+    def affordable(target: int) -> bool:
+        total = 0
+        for a, p, b, q, limit in processes:
+            best = ((target + a - 1) // a) * p
+            for count in range(1, min(limit, (target + b - 1) // b + 1)):
+                remaining = max(0, target - count * b)
+                cost = count * q + ((remaining + a - 1) // a) * p
+                best = min(best, cost)
+            total += best
+            if total > x:
+                return False
+        return True
+
+    low = 0
+    # Even spending the entire budget on one process cannot exceed this.
+    high = min(x * a // p for a, p, _, _, _ in processes) + 1
+    while high - low > 1:
+        middle = (low + high) // 2
+        if affordable(middle):
+            low = middle
+        else:
+            high = middle
+    return low
