diff --git a/solution.py b/solution.py
index 571a8c1..1ac39f5 100644
--- a/solution.py
+++ b/solution.py
@@ -21,4 +21,42 @@ def can_transform(k: int, s: str, t: str) -> bool:
     >>> can_transform(17, 'twothousandtwentyfour', 'happynewyear')
     True
     """
-    pass
+    if abs(len(s) - len(t)) > k:
+        return False
+
+    # On diagonal d, retain only the furthest source position reachable
+    # with the current edit budget. Earlier positions cannot do better.
+    n, m = len(s), len(t)
+    start = 0
+    while start < min(n, m) and s[start] == t[start]:
+        start += 1
+    frontier = {0: start}
+    if start == n == m:
+        return True
+
+    for edits in range(1, k + 1):
+        next_frontier = {}
+        for diagonal in range(-edits, edits + 1):
+            furthest = -1
+            # Insertion, deletion, and replacement, respectively.
+            for previous, advance in ((diagonal + 1, 0),
+                                      (diagonal - 1, 1),
+                                      (diagonal, 1)):
+                if previous not in frontier:
+                    continue
+                i = frontier[previous] + advance
+                j = i - diagonal
+                if 0 <= i <= n and 0 <= j <= m:
+                    furthest = max(furthest, i)
+            if furthest < 0:
+                continue
+            i = furthest
+            j = i - diagonal
+            while i < n and j < m and s[i] == t[j]:
+                i += 1
+                j += 1
+            if i == n and j == m:
+                return True
+            next_frontier[diagonal] = i
+        frontier = next_frontier
+    return False
