--- a/solution.py
+++ b/solution.py
@@ -13,4 +13,33 @@ def count_power_representations(n: int) -> int:
     >>> count_power_representations(1000000000000000000)
     1001003332
     """
-    pass
+    # Every perfect power other than 1 has a maximal exponent. Inclusion-
+    # exclusion over divisors of that exponent counts each value exactly once.
+    max_exponent = n.bit_length() - 1
+    mobius = [1] * (max_exponent + 1)
+    prime = [True] * (max_exponent + 1)
+    for p in range(2, max_exponent + 1):
+        if prime[p]:
+            for multiple in range(p, max_exponent + 1, p):
+                prime[multiple] = False
+                mobius[multiple] *= -1
+            for multiple in range(p * p, max_exponent + 1, p * p):
+                mobius[multiple] = 0
+
+    def integer_root(exponent: int) -> int:
+        # Use integer arithmetic to stay exact at large power boundaries.
+        low = 1
+        high = 1 << ((n.bit_length() + exponent - 1) // exponent)
+        while low + 1 < high:
+            middle = (low + high) // 2
+            if middle ** exponent <= n:
+                low = middle
+            else:
+                high = middle
+        return low
+
+    return 1 - sum(
+        mobius[exponent] * (integer_root(exponent) - 1)
+        for exponent in range(2, max_exponent + 1)
+        if mobius[exponent]
+    )
