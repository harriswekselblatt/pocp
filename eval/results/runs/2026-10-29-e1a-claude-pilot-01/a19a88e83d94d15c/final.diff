diff --git a/solution.py b/solution.py
index 9a7d7ae..9c9283a 100644
--- a/solution.py
+++ b/solution.py
@@ -1,19 +1,22 @@
+MOD = 10**9 + 7
+
+
 def count_k_reducible(s: str, k: int) -> int:
     """ Given a binary string s representing a number n and an integer k,
     return the count of positive integers less than n that are k-reducible.
-    
+
     An integer x is k-reducible if performing the following operation at most k times
     reduces it to 1: Replace x with the count of set bits (1s) in its binary representation.
-    
+
     The result should be returned modulo 10^9 + 7.
-    
+
     Args:
         s: Binary string representing n (1 <= len(s) <= 800, no leading zeros)
         k: Maximum number of operations allowed (1 <= k <= 5)
-    
+
     Returns:
         Count of k-reducible positive integers less than n, modulo 10^9 + 7
-    
+
     >>> count_k_reducible("111", 1)
     3
     >>> count_k_reducible("1000", 2)
@@ -21,4 +24,41 @@ def count_k_reducible(s: str, k: int) -> int:
     >>> count_k_reducible("1", 3)
     0
     """
-    pass
+    n_bits = len(s)
+
+    def min_steps(c):
+        steps = 0
+        while c != 1:
+            c = bin(c).count('1')
+            steps += 1
+        return steps
+
+    # x is k-reducible iff min_steps(popcount(x)) <= k-1
+    valid_counts = set()
+    for c in range(1, n_bits + 1):
+        if min_steps(c) <= k - 1:
+            valid_counts.add(c)
+
+    # Pascal's triangle mod MOD for digit DP
+    C = [[0] * (n_bits + 1) for _ in range(n_bits + 1)]
+    C[0][0] = 1
+    for i in range(1, n_bits + 1):
+        C[i][0] = 1
+        for j in range(1, i + 1):
+            C[i][j] = (C[i-1][j-1] + C[i-1][j]) % MOD
+
+    total = 0
+    for target in valid_counts:
+        # Count numbers in [0, n-1] with exactly `target` set bits
+        result = 0
+        ones_so_far = 0
+        for i, bit in enumerate(s):
+            if bit == '1':
+                remaining = n_bits - 1 - i
+                needed = target - ones_so_far
+                if 0 <= needed <= remaining:
+                    result = (result + C[remaining][needed]) % MOD
+                ones_so_far += 1
+        total = (total + result) % MOD
+
+    return total
