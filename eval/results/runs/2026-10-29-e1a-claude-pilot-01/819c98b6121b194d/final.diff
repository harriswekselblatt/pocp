     >>> count_good_arrays(5, 2, 0)
     2
     """
-    pass
+    MOD = 10**9 + 7
+
+    if k > n - 1:
+        return 0
+
+    # n-k runs; C(n-1, k) ways to place run boundaries;
+    # m choices for first run, (m-1) for each subsequent run
+    runs = n - k
+
+    fact = [1] * n
+    for i in range(1, n):
+        fact[i] = fact[i - 1] * i % MOD
+
+    inv_fact = [1] * n
+    inv_fact[n - 1] = pow(fact[n - 1], MOD - 2, MOD)
+    for i in range(n - 2, -1, -1):
+        inv_fact[i] = inv_fact[i + 1] * (i + 1) % MOD
+
+    def comb(a, b):
+        if b < 0 or b > a:
+            return 0
+        return fact[a] * inv_fact[b] % MOD * inv_fact[a - b] % MOD
+
+    result = comb(n - 1, k) * m % MOD
+    if runs > 1:
+        result = result * pow(m - 1, runs - 1, MOD) % MOD
