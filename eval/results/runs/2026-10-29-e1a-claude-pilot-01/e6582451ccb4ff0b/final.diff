--- a/solution.py
+++ b/solution.py
@@ -23,4 +23,29 @@ def count_good_arrays(n: int, m: int, k: int) -> int:
     >>> count_good_arrays(5, 2, 0)
     2
     """
-    pass
+    MOD = 10**9 + 7
+
+    if k > n - 1:
+        return 0
+
+    max_val = n
+    fact = [1] * (max_val + 1)
+    for i in range(1, max_val + 1):
+        fact[i] = fact[i - 1] * i % MOD
+
+    inv_fact = [1] * (max_val + 1)
+    inv_fact[max_val] = pow(fact[max_val], MOD - 2, MOD)
+    for i in range(max_val - 1, -1, -1):
+        inv_fact[i] = inv_fact[i + 1] * (i + 1) % MOD
+
+    def comb(n, r):
+        if r < 0 or r > n:
+            return 0
+        return fact[n] * inv_fact[r] % MOD * inv_fact[n - r] % MOD
+
+    result = comb(n - 1, k) * m % MOD
+    diff_pairs = n - 1 - k
+    if diff_pairs > 0:
+        result = result * pow(m - 1, diff_pairs, MOD) % MOD
+
+    return result
