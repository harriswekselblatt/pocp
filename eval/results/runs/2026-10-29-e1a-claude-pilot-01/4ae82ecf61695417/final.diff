@@ -23,4 +23,24 @@ def count_good_arrays(n: int, m: int, k: int) -> int:
     >>> count_good_arrays(5, 2, 0)
     2
     """
-    pass
+    MOD = 10**9 + 7
+    exp = n - k - 1
+    if exp < 0:
+        return 0
+
+    max_val = n
+    fact = [1] * (max_val + 1)
+    for i in range(1, max_val + 1):
+        fact[i] = fact[i-1] * i % MOD
+
+    inv_fact = [1] * (max_val + 1)
+    inv_fact[max_val] = pow(fact[max_val], MOD - 2, MOD)
+    for i in range(max_val - 1, -1, -1):
+        inv_fact[i] = inv_fact[i+1] * (i+1) % MOD
+
+    def comb(a, b):
+        if b < 0 or b > a:
+            return 0
+        return fact[a] * inv_fact[b] % MOD * inv_fact[a-b] % MOD
+
+    return comb(n - 1, k) * m % MOD * pow(m - 1, exp, MOD) % MOD
