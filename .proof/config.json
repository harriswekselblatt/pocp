{
  "pocp": 1,
  "packet_ttl_days": 14,
  "run": {
    "mode": "clean",
    "timeout_ms": 600000,
    "env": "inherit"
  },
  "snapshot": {
    "link": [
      "node_modules"
    ]
  },
  "verify": {
    "require_ci": [
      "npm test --silent"
    ]
  },
  "ci": {
    "branch": "main",
    "required_checks": [
      "pocp",
      "test (ubuntu-latest, 20)",
      "test (ubuntu-latest, 22)",
      "test (ubuntu-latest, 24)",
      "eval (ubuntu-latest)"
    ],
    "require_pull_request": true,
    "enforce_admins": true,
    "require_up_to_date": true,
    "files": [
      ".github/workflows/**",
      ".github/actions/**",
      "action.yml",
      "action.yaml",
      ".gitlab-ci.yml",
      ".gitlab/ci/**",
      ".circleci/**",
      "Jenkinsfile",
      "azure-pipelines.yml",
      "bitbucket-pipelines.yml",
      ".buildkite/**",
      ".drone.yml",
      ".woodpecker/**",
      ".woodpecker.yml",
      "eval/tasks/frozen/**",
      "eval/reference/**",
      "eval/lib/**",
      "eval/PREREG.md",
      "eval/**",
      "docs/EVAL-PLAN.md"
    ],
    "workflow_approver": "any-writer"
  },
  "guard": {
    "mutants": 0
  }
}
