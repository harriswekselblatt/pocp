{
  "pocp": 1,
  "triggers": {
    "broad_files": 6,
    "cross_area": {
      "areas": 3,
      "min_files": 4
    },
    "globs": [
      {
        "id": "docs",
        "glob": "*.md",
        "require_packet": false
      },
      {
        "id": "examples",
        "glob": "examples/**",
        "require_packet": false
      }
    ]
  },
  "requirements": [
    {
      "id": "test-suite",
      "globs": [
        "src/**",
        "bin/**",
        "test/**",
        "package.json"
      ],
      "obligation": {
        "kind": "test",
        "run": "node --test test/*.test.js",
        "changed_test_command": [
          "node",
          "--test",
          "{tests}"
        ]
      },
      "source": "author",
      "defer": "ci"
    },
    {
      "id": "eval-tests",
      "globs": [
        "eval/**"
      ],
      "obligation": {
        "kind": "test",
        "run": "./eval/run-tests.sh"
      },
      "source": "author"
    }
  ]
}
