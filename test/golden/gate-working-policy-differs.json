{
  "case": "gate-working-policy-differs",
  "about": "today gate reads the working copy's policy, not the staged one (a planned change will judge the staged policy)",
  "runs": [
    {
      "args": [
        "gate",
        "--json"
      ],
      "exit": 2,
      "json": {
        "pocp": 1,
        "ok": false,
        "error": "invalid JSON in <repo>/.proof/config.json: <JSON.parse message>"
      },
      "stderr": ""
    }
  ]
}
